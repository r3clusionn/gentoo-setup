-*net-misc/wget
-*sys-apps/net-tools
-*sys-fs/e2fsprogs
-*virtual/ssh
-*net-mail/mailbase
# batch 11 (2026-10-10): no man pages, no ping, no which
-*sys-apps/man-pages
-*virtual/man
-*net-misc/iputils
-*sys-apps/which

# batch 15 (2026-10-14): util-linux more satisfies virtual/pager; econf skips
# config.sub updates without gnuconfig; psmisc also in package.provided
-*sys-devel/gnuconfig
-*sys-apps/less
-*sys-process/psmisc

# batch 18 (2026-10-15): no text editor in the base system (owner chose it; consoles have none now)
-*virtual/editor
-*app-editors/nano

# batch 21 (2026-10-17): console keymap = kernel default (US, UTF-8); keymaps/termencoding services dropped
-*sys-apps/kbd

