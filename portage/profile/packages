# unmerged with their CONTENTS emptied first, so /bin/sh -> dash, awk, gzip, bzip2,
# tar and ninja links stay (unowned). dash is in world. Undo: emerge -1 them from binpkgs.
-*app-alternatives/sh
-*app-alternatives/awk
-*app-alternatives/bzip2
-*app-alternatives/gzip
-*app-alternatives/tar

# 2026-10-18: @system virtuals nothing else depends on (providers are in world)
-*virtual/pager
-*virtual/dev-manager
-*virtual/libc
-*virtual/service-manager
-*virtual/package-manager
-*virtual/os-headers
